{
  "name": "nuns-on-the-run",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --host 0.0.0.0 --port 5207 --strictPort",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4207 --strictPort",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "art:prepare": "node scripts/prepare-art.mjs",
    "test:unit": "node --experimental-strip-types --test tests/*.test.ts",
    "test:browser": "playwright test",
    "test:rules": "node --experimental-strip-types --test --test-concurrency=1 tests/firebase/*.test.ts",
    "test:multiplayer": "playwright test --config playwright.game.config.ts",
    "test:backend": "firebase emulators:exec --project demo-nuns --only auth,database \"npm run test:rules && npm run test:multiplayer\"",
    "emulators": "firebase emulators:start --project demo-nuns --only auth,database"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "6.0.0",
    "@playwright/test": "1.65.1",
    "@sveltejs/adapter-static": "3.0.10",
    "@sveltejs/kit": "2.69.3",
    "@sveltejs/vite-plugin-svelte": "7.2.0",
    "@types/node": "^24.19.2",
    "@types/qrcode": "1.5.6",
    "@types/three": "^0.185.4",
    "firebase-tools": "15.36.0",
    "sharp": "^0.35.5",
    "svelte": "5.56.5",
    "svelte-check": "4.7.2",
    "typescript": "5.9.3",
    "vite": "8.1.4"
  },
  "dependencies": {
    "firebase": "13.3.0",
    "qrcode": "1.5.4",
    "three": "^0.185.1"
  },
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/anicolao/nuns.git"
  },
  "engines": {
    "node": ">=24.12.0"
  }
}
